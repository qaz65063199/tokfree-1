# Cloudflare R2 配置（复制本文件为 .env 并填入真实值；.env 已被 gitignore，不会泄露）
# R2 账户 ID（在 Cloudflare R2 控制台右侧「账户 ID」，或从 S3 endpoint 域名中获取）
R2_ACCOUNT_ID=your_account_id
# R2 的 S3 API 访问密钥（Cloudflare → R2 → Manage R2 API Tokens 创建，选 Object Read & Write）
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
# 存储桶名
R2_BUCKET=tokfree-dl
# 可选：产物目录（默认 dist）
# DIST_DIR=dist
